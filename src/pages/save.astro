---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <div class="border-b border-border"></div>
    <section class="p-4">
      <h1 class="text-2xl font-bold mb-4">Shared Content</h1>
      <div id="shared-info" class="space-y-2">
        <p class="text-muted-foreground">No shared content received.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const params = new URLSearchParams(window.location.search);
    const url = params.get("url");
    const title = params.get("title");
    const text = params.get("text");

    if (url || title || text) {
      const container = document.getElementById("shared-info");
      if (!container) return;

      let html = "";
      if (title) {
        html += `<p><strong>Title:</strong> ${title}</p>`;
      }
      if (url) {
        html += `<p><strong>URL:</strong> <a href="${url}" class="text-accent underline" target="_blank" rel="noopener">${url}</a></p>`;
      }
      if (text) {
        html += `<p><strong>Text:</strong> ${text}</p>`;
      }
      container.innerHTML = html;
    }
  });
</script>
