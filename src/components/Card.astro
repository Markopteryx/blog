---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
---

<li class="group my-6 transition-transform duration-200 ease-out">
  <div class="flex items-baseline justify-between gap-4">
    <a
      href={getPath(id, filePath)}
      class:list={[
        "inline-block text-lg font-medium text-accent",
        "link-underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")), fontFamily: "var(--font-google-open-sans), sans-serif" }}>
        {title}
      </Heading>
    </a>
    <Datetime {...props} />
  </div>
  <p class="pt-0.5 text-sm" style="font-family: var(--font-google-open-sans), sans-serif;">{description}</p>
</li>
