<aside
  id="scroll-toc"
  class="fixed left-0 top-1/2 -translate-y-1/2 z-50 h-[90vh] py-0 pr-6 pl-4 hidden min-[1200px]:block"
>
  <div id="toc-hover-zone" class="fixed left-0 top-0 w-75 h-screen -z-10"></div>
  <div id="toc-bar" class="relative h-full flex flex-col">
    <svg
      id="toc-thumb"
      class="absolute -left-0.75 w-2 pointer-events-none"
      style="top: 0; height: 15%"
      viewBox="0 0 20 100"
      preserveAspectRatio="none"
    >
      <path
        id="blob-path"
        fill="var(--accent)"
        d="M10,5 C16,5 18,15 18,25 C18,40 16,60 18,75 C18,85 16,95 10,95 C4,95 2,85 2,75 C2,60 4,40 2,25 C2,15 4,5 10,5 Z"
      />
    </svg>
  </div>
</aside>

<style>
  @reference "../styles/global.css";

  #scroll-toc {
    --toc-saturation: 1;
    --toc-scale: 1;
  }

  #scroll-toc.dormant {
    --toc-saturation: 0;
    --toc-scale: 0.8;
  }

  #toc-bar {
    transform: scaleY(var(--toc-scale));
    transform-origin: center center;
    transition: transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #toc-bar :global(.toc-segment) {
    @apply relative w-0.5 grow;
    background-color: var(--muted);
    transition: filter 800ms ease-out;
    filter: grayscale(calc(1 - var(--toc-saturation)));
  }

  #toc-bar :global(.toc-dot-wrapper) {
    @apply flex items-center py-1 shrink-0;
  }

  #toc-bar :global(.toc-dot) {
    @apply relative w-2.25 h-2.25 -ml-[3.5px] rounded-full cursor-pointer;
    background-color: var(--muted);
    transition: transform 200ms ease-in-out, filter 800ms ease-out;
    filter: grayscale(calc(1 - var(--toc-saturation)));
  }

  #toc-bar :global(.toc-dot::before) {
    content: "";
    @apply absolute -top-2 -left-2 -right-2 -bottom-2 rounded-full;
  }

  #toc-bar :global(.toc-dot.h3),
  #toc-bar :global(.toc-dot.h4) {
    @apply w-1.75 h-1.75 -ml-[2.5px];
  }

  #toc-bar :global(.toc-dot:hover),
  #toc-bar :global(.toc-dot.active) {
    @apply bg-accent scale-[1.3];
  }

  #toc-bar :global(.toc-label) {
    @apply absolute left-4 top-1/2 -translate-y-1/2 -translate-x-1.25 leading-tight text-foreground opacity-0 cursor-pointer w-max max-w-70 whitespace-nowrap bg-background py-1 px-2;
    font-size: 0.7rem;
    transition: opacity 200ms ease-in-out, transform 200ms ease-in-out, color 200ms ease-in-out;
  }

  #toc-bar :global(.toc-label:hover) {
    @apply text-accent;
  }

  #toc-hover-zone:hover ~ #toc-bar :global(.toc-label),
  #toc-bar:hover :global(.toc-label) {
    @apply opacity-100 -translate-y-1/2 translate-x-0;
  }

  #toc-bar :global(.toc-dot.active .toc-label) {
    @apply text-accent;
  }

  #toc-thumb {
    transition: filter 800ms ease-out;
    filter: grayscale(calc(1 - var(--toc-saturation)));
  }
</style>

<script>
  function initScrollToc() {
    const article = document.getElementById("article");
    const tocBar = document.getElementById("toc-bar");
    const tocThumb = document.getElementById("toc-thumb") as unknown as SVGElement;
    const blobPath = document.getElementById("blob-path") as unknown as SVGPathElement;
    const scrollToc = document.getElementById("scroll-toc");

    if (!article || !tocBar || !tocThumb || !blobPath || !scrollToc) return;

    const headings = Array.from(
      article.querySelectorAll("h2, h3, h4")
    ) as HTMLElement[];

    if (headings.length === 0) {
      scrollToc.style.display = "none";
      return;
    }

    // Clear existing content except thumb
    const existingThumb = tocBar.querySelector(".toc-thumb");
    tocBar.innerHTML = "";
    if (existingThumb) tocBar.appendChild(existingThumb);

    const docHeight = document.documentElement.scrollHeight;
    const viewportHeight = window.innerHeight;
    const scrollableHeight = docHeight - viewportHeight;

    // Get positions for each heading relative to scrollable area
    const headingPositions = headings.map((h) => {
      const top = h.getBoundingClientRect().top + window.scrollY;
      return {
        element: h,
        top,
        // Visual position - where dot sits in the bar (based on actual heading position)
        visualPercent: scrollableHeight > 0 ? (top / scrollableHeight) * 85 : 0,
        // Activation position - when dot lights up (offset so it matches thumb visually)
        activationPercent: scrollableHeight > 0 ? (Math.max(0, top - viewportHeight * 0.4) / scrollableHeight) * 85 : 0,
      };
    });

    // Create segments and dots based on heading positions in document
    let lastPercent = 0;

    headingPositions.forEach((hp, index) => {
      // Create segment before this dot (use visual position for layout)
      const segment = document.createElement("div");
      segment.className = "toc-segment";
      const segmentSize = hp.visualPercent - lastPercent;
      segment.style.flexGrow = String(Math.max(0.1, segmentSize));
      tocBar.appendChild(segment);

      // Create dot wrapper (for gap)
      const dotWrapper = document.createElement("div");
      dotWrapper.className = "toc-dot-wrapper";

      // Create dot
      const dot = document.createElement("div");
      dot.className = `toc-dot ${hp.element.tagName.toLowerCase()}`;
      dot.dataset.index = String(index);

      const label = document.createElement("span");
      label.className = "toc-label";
      label.textContent = hp.element.textContent?.replace(/#$/, "").trim() || "";
      dot.appendChild(label);

      const scrollToHeading = () => {
        hp.element.scrollIntoView({ behavior: "smooth" });
      };

      dot.addEventListener("click", scrollToHeading);
      label.addEventListener("click", scrollToHeading);

      dotWrapper.appendChild(dot);
      tocBar.appendChild(dotWrapper);

      lastPercent = hp.visualPercent;
    });

    // Final segment - from last heading to end of scrollable content
    const finalSegment = document.createElement("div");
    finalSegment.className = "toc-segment";
    const remainingPercent = 85 - lastPercent;
    finalSegment.style.flexGrow = String(Math.max(0.1, remainingPercent));
    tocBar.appendChild(finalSegment);

    // Re-append thumb so it's on top
    tocBar.appendChild(tocThumb);

    const dots = tocBar.querySelectorAll(".toc-dot") as NodeListOf<HTMLElement>;

    // Blob shape variants
    const blobShapes = {
      rest: "M10,5 C16,5 18,15 18,25 C18,40 16,60 18,75 C18,85 16,95 10,95 C4,95 2,85 2,75 C2,60 4,40 2,25 C2,15 4,5 10,5 Z",
      down: "M10,3 C18,3 17,18 16,28 C15,42 17,58 16,72 C15,85 18,97 10,97 C2,97 5,85 4,72 C3,58 5,42 4,28 C3,18 2,3 10,3 Z",
      up: "M10,4 C15,4 19,12 18,24 C17,38 15,62 17,76 C19,88 15,96 10,96 C5,96 1,88 3,76 C5,62 3,38 2,24 C1,12 5,4 10,4 Z",
    };

    let lastScrollTop = 0;
    let scrollVelocity = 0;
    let currentShape = "rest";
    let targetTop = 0;
    let currentTop = 0;
    let isAnimating = false;
    let dormantTimeout: number | null = null;
    let isHovered = false;
    const dotsTouching = new Set<number>();

    function wakeUp() {
      scrollToc?.classList.remove("dormant");
      if (dormantTimeout) clearTimeout(dormantTimeout);
      if (!isHovered) {
        dormantTimeout = window.setTimeout(() => {
          scrollToc?.classList.add("dormant");
        }, 3000);
      }
    }

    // Spring physics for smooth blob movement
    function animateBlobPosition() {
      if (!tocBar) return;
      const diff = targetTop - currentTop;
      const spring = 0.15;

      currentTop += diff * spring;
      scrollVelocity *= 0.75;

      // Check thumb-dot collisions
      const tocBarRect = tocBar.getBoundingClientRect();
      const thumbTopPx = (currentTop / 100) * tocBarRect.height;
      const thumbHeight = tocBarRect.height * 0.15;
      const thumbBottomPx = thumbTopPx + thumbHeight;

      dots.forEach((dot, i) => {
        const dotRect = dot.getBoundingClientRect();
        const dotTopRelative = dotRect.top - tocBarRect.top;
        const dotBottomRelative = dotTopRelative + dotRect.height;

        const isTouching =
          thumbBottomPx > dotTopRelative && thumbTopPx < dotBottomRelative;
        const wasTouching = dotsTouching.has(i);

        if (isTouching && !wasTouching) {
          dotsTouching.add(i);
          dot.style.transform = "scale(0.6)";
          setTimeout(() => {
            dot.style.transform = "scale(1.3)";
            setTimeout(() => {
              dot.style.transform = "";
            }, 150);
          }, 100);
          // Blob bulges
          blobPath.setAttribute(
            "d",
            "M10,5 C20,5 20,20 19,30 C18,45 18,55 19,70 C20,80 20,95 10,95 C0,95 0,80 1,70 C2,55 2,45 1,30 C0,20 0,5 10,5 Z"
          );
        } else if (!isTouching && wasTouching) {
          dotsTouching.delete(i);
          dot.style.transform = "scale(1.15)";
          setTimeout(() => {
            dot.style.transform = "";
          }, 150);
        }
      });

      if (Math.abs(diff) > 0.01) {
        tocThumb.style.top = `${currentTop}%`;
        isAnimating = true;
        requestAnimationFrame(animateBlobPosition);
      } else {
        currentTop = targetTop;
        tocThumb.style.top = `${currentTop}%`;
        isAnimating = false;
      }
    }

    function updateProgress() {
      if (!tocThumb || !tocBar) return;

      const scrollTop = window.scrollY;
      const velocity = scrollTop - lastScrollTop;
      scrollVelocity = velocity;
      lastScrollTop = scrollTop;

      // Target position
      const scrollPercent =
        scrollableHeight > 0 ? scrollTop / scrollableHeight : 0;
      targetTop = Math.min(85, scrollPercent * 85);

      if (!isAnimating) {
        requestAnimationFrame(animateBlobPosition);
      }

      // Morph blob based on scroll direction
      const absVelocity = Math.abs(velocity);
      if (absVelocity > 15) {
        const newShape = velocity > 0 ? "down" : "up";
        if (newShape !== currentShape) {
          currentShape = newShape;
          blobPath.setAttribute("d", blobShapes[newShape]);
        }
      } else if (absVelocity < 3 && currentShape !== "rest") {
        currentShape = "rest";
        blobPath.setAttribute("d", blobShapes.rest);
      }

      // Stretch/squash based on velocity
      const scaleY = 1 + Math.min(0.3, absVelocity * 0.005);
      const scaleX = 1 - Math.min(0.2, absVelocity * 0.003);
      tocThumb.style.transform = `scaleX(${scaleX}) scaleY(${scaleY})`;

      // Find current heading index
      const thumbPercent = scrollPercent * 85;
      let currentIndex = -1;
      for (let i = headingPositions.length - 1; i >= 0; i--) {
        if (thumbPercent >= headingPositions[i].activationPercent) {
          currentIndex = i;
          break;
        }
      }

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.remove("active");
        if (i === currentIndex) {
          dot.classList.add("active");
        }
      });
    }

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Wake up on hover over ToC area
    const tocHoverZone = document.getElementById("toc-hover-zone");
    scrollToc.addEventListener("mouseenter", () => {
      isHovered = true;
      wakeUp();
    });
    scrollToc.addEventListener("mouseleave", () => {
      isHovered = false;
      wakeUp();
    });
    tocHoverZone?.addEventListener("mouseenter", () => {
      isHovered = true;
      wakeUp();
    });
    tocHoverZone?.addEventListener("mouseleave", () => {
      isHovered = false;
      wakeUp();
    });

    // Start dormant immediately
    scrollToc.classList.add("dormant");
    updateProgress();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      requestAnimationFrame(initScrollToc);
    });
  } else {
    requestAnimationFrame(initScrollToc);
  }

  document.addEventListener("astro:after-swap", () => {
    requestAnimationFrame(initScrollToc);
  });
</script>
