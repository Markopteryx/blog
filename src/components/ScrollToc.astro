<aside id="scroll-toc" class="scroll-toc">
  <div class="toc-hover-zone" id="toc-hover-zone"></div>
  <div class="toc-bar" id="toc-bar">
    <div class="toc-thumb" id="toc-thumb"></div>
  </div>
</aside>

<style>
  .scroll-toc {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    height: 90vh;
    padding: 0 1.5rem 0 1rem;
  }

  .toc-hover-zone {
    position: fixed;
    left: 0;
    top: 0;
    width: 300px;
    height: 100vh;
    z-index: -1;
  }

  @media (max-width: 1200px) {
    .scroll-toc {
      display: none;
    }
  }

  .toc-bar {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .toc-thumb {
    position: absolute;
    left: 0;
    width: 2px;
    height: 15%;
    background: var(--accent);
    border-radius: 1px;
    transition: top 0.1s ease-out;
    top: 0;
    pointer-events: none;
  }

  .toc-bar :global(.toc-segment) {
    position: relative;
    width: 2px;
    background: var(--muted);
    flex-grow: 1;
  }

  .toc-bar :global(.toc-dot-wrapper) {
    display: flex;
    align-items: center;
    padding: 4px 0;
    flex-shrink: 0;
  }

  .toc-bar :global(.toc-dot) {
    position: relative;
    width: 9px;
    height: 9px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--muted);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .toc-bar :global(.toc-dot::before) {
    content: "";
    position: absolute;
    top: -8px;
    left: -8px;
    right: -8px;
    bottom: -8px;
    border-radius: 50%;
  }

  .toc-bar :global(.toc-dot.h3),
  .toc-bar :global(.toc-dot.h4) {
    width: 7px;
    height: 7px;
    margin-left: -2.5px;
  }

  .toc-bar :global(.toc-dot:hover),
  .toc-bar :global(.toc-dot.active) {
    background: var(--accent);
    transform: scale(1.3);
  }

  .toc-bar :global(.toc-label) {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%) translateX(-5px);
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
    width: max-content;
    max-width: 280px;
    white-space: nowrap;
    background: var(--background);
    padding: 0.25rem 0.5rem;
  }

  .toc-bar :global(.toc-label:hover) {
    color: var(--accent);
  }

  .toc-hover-zone:hover ~ .toc-bar :global(.toc-label),
  .toc-bar:hover :global(.toc-label) {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .toc-bar :global(.toc-dot.active .toc-label) {
    color: var(--accent);
  }
</style>

<script>
  function initScrollToc() {
    const article = document.getElementById("article");
    const tocBar = document.getElementById("toc-bar");
    const tocThumb = document.getElementById("toc-thumb");
    const scrollToc = document.getElementById("scroll-toc");

    if (!article || !tocBar || !tocThumb || !scrollToc) return;

    const headings = Array.from(
      article.querySelectorAll("h2, h3, h4")
    ) as HTMLElement[];

    if (headings.length === 0) {
      scrollToc.style.display = "none";
      return;
    }

    // Clear existing content except thumb
    const existingThumb = tocBar.querySelector(".toc-thumb");
    tocBar.innerHTML = "";
    if (existingThumb) tocBar.appendChild(existingThumb);

    const docHeight = document.documentElement.scrollHeight;
    const viewportHeight = window.innerHeight;
    const scrollableHeight = docHeight - viewportHeight;

    // Get positions for each heading relative to scrollable area
    const headingPositions = headings.map((h) => {
      const top = h.getBoundingClientRect().top + window.scrollY;
      return {
        element: h,
        top,
        // Visual position - where dot sits in the bar (based on actual heading position)
        visualPercent: scrollableHeight > 0 ? (top / scrollableHeight) * 85 : 0,
        // Activation position - when dot lights up (offset so it matches thumb visually)
        activationPercent: scrollableHeight > 0 ? (Math.max(0, top - viewportHeight * 0.4) / scrollableHeight) * 85 : 0,
      };
    });

    // Create segments and dots based on heading positions in document
    let lastPercent = 0;

    headingPositions.forEach((hp, index) => {
      // Create segment before this dot (use visual position for layout)
      const segment = document.createElement("div");
      segment.className = "toc-segment";
      const segmentSize = hp.visualPercent - lastPercent;
      segment.style.flexGrow = String(Math.max(0.1, segmentSize));
      tocBar.appendChild(segment);

      // Create dot wrapper (for gap)
      const dotWrapper = document.createElement("div");
      dotWrapper.className = "toc-dot-wrapper";

      // Create dot
      const dot = document.createElement("div");
      dot.className = `toc-dot ${hp.element.tagName.toLowerCase()}`;
      dot.dataset.index = String(index);

      const label = document.createElement("span");
      label.className = "toc-label";
      label.textContent = hp.element.textContent?.replace(/#$/, "").trim() || "";
      dot.appendChild(label);

      const scrollToHeading = () => {
        hp.element.scrollIntoView({ behavior: "smooth" });
      };

      dot.addEventListener("click", scrollToHeading);
      label.addEventListener("click", scrollToHeading);

      dotWrapper.appendChild(dot);
      tocBar.appendChild(dotWrapper);

      lastPercent = hp.visualPercent;
    });

    // Final segment - from last heading to end of scrollable content
    const finalSegment = document.createElement("div");
    finalSegment.className = "toc-segment";
    const remainingPercent = 85 - lastPercent;
    finalSegment.style.flexGrow = String(Math.max(0.1, remainingPercent));
    tocBar.appendChild(finalSegment);

    // Re-append thumb so it's on top
    tocBar.appendChild(tocThumb);

    const dots = tocBar.querySelectorAll(".toc-dot") as NodeListOf<HTMLElement>;

    function updateProgress() {
      if (!tocThumb) return;

      const scrollTop = window.scrollY;
      
      // Move thumb like a scrollbar (0-85% to account for thumb height)
      const scrollPercent = scrollableHeight > 0 
        ? (scrollTop / scrollableHeight) 
        : 0;
      tocThumb.style.top = `${Math.min(85, scrollPercent * 85)}%`;

      // Find current heading index - use activation percent so dot lights up when thumb reaches it
      const thumbPercent = scrollPercent * 85;
      let currentIndex = -1;
      for (let i = headingPositions.length - 1; i >= 0; i--) {
        if (thumbPercent >= headingPositions[i].activationPercent) {
          currentIndex = i;
          break;
        }
      }

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.remove("active");
        if (i === currentIndex) {
          dot.classList.add("active");
        }
      });
    }

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    });

    updateProgress();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      requestAnimationFrame(initScrollToc);
    });
  } else {
    requestAnimationFrame(initScrollToc);
  }

  document.addEventListener("astro:after-swap", () => {
    requestAnimationFrame(initScrollToc);
  });
</script>
